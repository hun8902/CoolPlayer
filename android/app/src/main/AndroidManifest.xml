<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <application android:theme="@style/AppTheme" android:label="Cool Player" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:resizeableActivity="true" android:configChanges="uiMode|screenSize|smallestScreenSize|orientation|screenLayout">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".PlaybackService" android:foregroundServiceType="mediaPlayback" android:exported="true">
            <intent-filter><action android:name="androidx.media3.session.MediaSessionService"/></intent-filter>
        </service>
        <receiver android:name=".PlayerWidget" android:label="Cool Player · 가로형" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/player_widget"/>
        </receiver>
        <receiver android:name=".SquarePlayerWidget" android:label="Cool Player · 앨범형" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/player_widget_square"/>
        </receiver>
        <service android:name=".PlaylistWidgetService" android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false"/>
        <receiver android:name=".SmallPlaylistWidget" android:label="Cool Player · 작은 재생목록" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/playlist_widget_small"/>
        </receiver>
        <receiver android:name=".PlaylistWidget" android:label="Cool Player · 재생목록" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/playlist_widget"/>
        </receiver>
    </application>
</manifest>
