<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_art" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/brand" android:scaleType="centerCrop" android:contentDescription="앨범아트"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cool Player" android:textSize="16sp" android:textStyle="bold" android:textColor="#20252F" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="음악을 선택하세요" android:textSize="12sp" android:textColor="#667084" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center">
        <Button android:id="@+id/widget_previous" android:layout_width="64dp" android:layout_height="48dp" android:text="|◀" android:contentDescription="이전 곡"/>
        <Button android:id="@+id/widget_play" android:layout_width="80dp" android:layout_height="48dp" android:text="▶" android:contentDescription="재생 또는 일시정지"/>
        <Button android:id="@+id/widget_next" android:layout_width="64dp" android:layout_height="48dp" android:text="▶|" android:contentDescription="다음 곡"/>
    </LinearLayout>
</LinearLayout>
