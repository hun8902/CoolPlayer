<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/playlist_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="8dp">

<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:orientation="vertical">
<TextView android:id="@+id/playlist_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_ink"/>
<TextView android:id="@+id/playlist_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp" android:paddingBottom="2dp" android:textColor="@color/widget_muted"/>
</LinearLayout><TextView android:layout_width="32dp" android:layout_height="48dp" android:gravity="center" android:text="▶" android:contentDescription="재생" android:textColor="@color/widget_ink"/>
</LinearLayout>