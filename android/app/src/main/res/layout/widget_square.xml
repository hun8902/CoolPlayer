<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
<ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="8dp" android:src="@drawable/widget_placeholder" android:scaleType="fitCenter" android:contentDescription="앨범아트"/><TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cool Player" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_ink" android:maxLines="1" android:ellipsize="end"/>
